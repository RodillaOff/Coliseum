# Copiá este archivo a ".env" y completá los valores. NUNCA subas ".env" a Git (está en .gitignore).
# Los valores reales los define cada integrante; aquí solo van los nombres de las variables.

# --- Conexión de la aplicación a la base de datos ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# REQUIRED para Aiven (cifrado obligatorio). DISABLED solo para la base local en Docker.
DB_SSL_MODE=

# --- Solo para docker compose (base de datos local) ---
# Contraseña del usuario root de MySQL dentro del contenedor.
DB_ROOT_PASSWORD=

# --- Opcional: modo servicio (Docker/Kubernetes) ---
# Puerto del endpoint /health. Si se deja vacío usa 8080.
APP_PORT=
