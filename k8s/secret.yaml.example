# Plantilla del Secret. NO la uses tal cual ni subas valores reales a Git.
# Opción recomendada (los valores no quedan en ningún archivo):
#   kubectl create secret generic coliseum-secret \
#     --from-literal=DB_USER=coliseum \
#     --from-literal=DB_PASSWORD='<contraseña>'
# Opción con archivo: copiá esto a k8s/secret.yaml (está en .gitignore), completá y aplicá.
apiVersion: v1
kind: Secret
metadata:
  name: coliseum-secret
type: Opaque
stringData:
  DB_USER: "<usuario>"
  DB_PASSWORD: "<contraseña>"
